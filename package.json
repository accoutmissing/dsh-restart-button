{
  "name": "@local/dsh-restart-button",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "One-click reload / restart button for the DeepSeek Harness desktop app: hot-reload plugin updates in place, fall back to a full app relaunch only when a reload cannot take.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "hot-reload",
    "restart",
    "electron"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/accoutmissing/dsh-restart-button.git"
  },
  "homepage": "https://github.com/accoutmissing/dsh-restart-button#readme",
  "bugs": {
    "url": "https://github.com/accoutmissing/dsh-restart-button/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
